      "name": "GET not in cache",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Код стану 200\", () => pm.response.to.have.status(200));\npm.test(\"Content-Type це image/jpeg\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.eql(\"image/jpeg\"));\npm.test(\"X-Cache це MISS\", () => pm.expect(pm.response.headers.get(\"X-Cache\")).to.eql(\"MISS\"));"
            ]
          }
        }
      ],
